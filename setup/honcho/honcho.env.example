# Honcho self-hosted env template (map #76 Task 3, D-A 2026-08-04).
# Copied to /opt/honcho/.env (mode 600) by setup/honcho.sh.
# Placeholders filled at first run: __HONCHO_DB_PASSWORD__, __MINIMAX_API_KEY__.

DB_CONNECTION_URI=postgresql+psycopg://honcho_app:__HONCHO_DB_PASSWORD__@127.0.0.1:5433/honcho
LOG_LEVEL=INFO

# --- LLM provider (MiniMax-M3 as OpenAI-compatible deriver; D-D gate) ---
# MiniMax does NOT honor response_format=json_schema; json_object is required
# (verified 2026-08-04 on Honcho v3.0.12). <think> preambles cost output budget.
LLM_OPENAI_API_KEY=__MINIMAX_API_KEY__
LLM_OPENAI_BASE_URL=https://api.minimax.chat/v1
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=MiniMax-M3
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.minimax.chat/v1
DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object

# --- Embedding provider (D-C, landed 2026-08-04: local Ollama nomic-embed-text) ---
# MiniMax 404s text-embedding-3-small; D-C chose local Ollama on the VM
# (benchmarked 2026-08-04: 137M params, ~1 s/chunk, 768-dim, ~40 MB RSS).
# Ollama serves 127.0.0.1:11434 only (zero public exposure). The key is
# reused because Ollama ignores auth; EMBEDDING_VECTOR_DIMENSIONS must
# match the pgvector columns (honcho DB migrated to vector(768)).
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=nomic-embed-text
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY
EMBEDDING_VECTOR_DIMENSIONS=768

# --- Auth ---
# API binds 127.0.0.1 only; auth stays off for V1 (zero public exposure).
AUTH_USE_AUTH=false
