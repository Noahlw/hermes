[Unit]
Description=Ollama embedding server (D-C 2026-08-04: local embeddings, nomic-embed-text 768-dim)
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
User=ubuntu
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
