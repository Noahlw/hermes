# Hermes reboot .env template (ADR 0005 / ticket #81).
#
# Copy to .env at the repo root, fill REQUIRED keys, run:
#   bash setup/install.sh
#
# Validated keys (REQUIRED): install.sh fails fast if any are empty.
# DR-only keys: only needed when RESTORE_KEY_PATH is set; install.sh skips
# the restore phase when RESTORE_KEY_PATH is empty.

# ---------------------------------------------------------------------------
# REQUIRED — Discord bots (one token per V1 Discord persona, see CONTEXT.md)
# ---------------------------------------------------------------------------

# Assistant Discord bot token.
DISCORD_BOT_TOKEN_ASSISTANT=

# Tutor Discord bot token.
DISCORD_BOT_TOKEN_TUTOR=

# Main Agent Discord bot token (ops/escalation super-set persona).
DISCORD_BOT_TOKEN_MAIN_AGENT=

# ---------------------------------------------------------------------------
# REQUIRED — model API
# ---------------------------------------------------------------------------

# Hermes is MiniMax-only (CONTEXT.md: MiniMax-only).
MINIMAX_API_KEY=

# ---------------------------------------------------------------------------
# REQUIRED — Discord routing
# ---------------------------------------------------------------------------

# The single Discord channel all three bots listen on
# (CONTEXT.md: Discord home channel).
DISCORD_HOME_CHANNEL=

# ---------------------------------------------------------------------------
# REQUIRED — install path
# ---------------------------------------------------------------------------

# Operator-chosen install path for the Hermes VM. The scripts/vm/*.sh
# defaults of /home/ubuntu/.hermes are historical; INSTALL.md documents
# the chosen real path. Must match the path the repo clone lives at
# (e.g. /home/ubuntu/hermes or /opt/hermes).
HERMES_HOME=

# ---------------------------------------------------------------------------
# DR-ONLY — Drive restore (unverified per ADR 0005 D3)
# Skip on zero-data fresh install; the Drive backup was never built.
# ---------------------------------------------------------------------------

# Absolute path to the age identity file that decrypts secrets.age from
# Drive. NEVER commit, NEVER upload to Drive. When unset, install.sh
# skips the restore phase entirely.
RESTORE_KEY_PATH=

# rclone remote name whose target is the operator's Google Drive.
RCLONE_CONFIG_PATH=

# Absolute path to the operator's age identity (alias of RESTORE_KEY_PATH
# kept for symmetry with backup_postgres_drive.sh).
AGE_IDENTITY_PATH=

# Google Drive folder id for hermes-pg backups (the restore scripts read
# this from the .env if set; otherwise the documented default is used).
DRIVE_FOLDER_ID=